{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/music-app-website/index.html" },
    { "source": "/css/:path*", "destination": "/music-app-website/css/:path*" },
    { "source": "/js/:path*", "destination": "/music-app-website/js/:path*" },
    { "source": "/assets/:path*", "destination": "/music-app-website/assets/:path*" },
    { "source": "/config/:path*", "destination": "/music-app-website/config/:path*" },
    { "source": "/apk/:path*", "destination": "/music-app-website/apk/:path*" },
    { "source": "/features", "destination": "/music-app-website/features.html" },
    { "source": "/music", "destination": "/music-app-website/music.html" },
    { "source": "/about", "destination": "/music-app-website/about.html" },
    { "source": "/download", "destination": "/music-app-website/download.html" },
    { "source": "/:match*", "destination": "/music-app-website/:match*" }
  ],
  "headers": [
    {
      "source": "/apk/:filename*",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Melodyx.apk\""
        }
      ]
    }
  ]
}
